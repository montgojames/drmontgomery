---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" pagefindIgnore>
  <div class="container not-found-page">
    <div class="prose-column">
      <h1>Page not found</h1>
      <p>The page you're looking for doesn't exist or may have moved.</p>
      <div class="not-found-page__actions">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-secondary" href="/medical-conditions/">Medical Conditions</a>
        <a class="btn btn-secondary" href="/search/">Search</a>
        <a class="btn btn-secondary" href="/about/">About</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Same padding-block rhythm as search.astro's .search-page — this is
     the site's other simple "heading + short text" page. */
  .not-found-page {
    padding-block: 3rem 4rem;
  }

  /* Same flex-row pattern as ArticleActions.astro's .article-actions. */
  .not-found-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
